# ============================================================
# Chatwoot 生产环境 .env 模板
#
# 部署方式：
#   cp .env.example .env
#   修改下面 ① FRONTEND_URL（必填）
#   （② ③ ④ 密钥留空即可，deploy.sh 会自动生成随机值）
# ============================================================

# ① 必填：客户最终访问 Chatwoot 的地址（你的域名，带 https）
FRONTEND_URL=https://chat.example.com

# ② Rails 会话密钥（deploy.sh 自动生成，勿手写）
SECRET_KEY_BASE=

# 界面默认语言：简体中文
DEFAULT_LOCALE=zh_CN

# 是否允许网页注册新账号
# 安装好并注册管理员后，建议改为 false 关闭注册
ENABLE_ACCOUNT_SIGNUP=true

# ===================== Redis =====================
# 容器内主机名，不要改
REDIS_URL=redis://redis:6379
# ③ Redis 密码（deploy.sh 自动生成）
REDIS_PASSWORD=

# ===================== PostgreSQL =====================
# 数据库名留空 = 使用官方默认 chatwoot_production（推荐，与官方一致）
# POSTGRES_DATABASE=
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
# ④ PostgreSQL 密码（deploy.sh 自动生成）
POSTGRES_PASSWORD=

# ===================== 移动端推送 =====================
# 启用内置 Push Relay：Chatwoot iOS/Android 官方 App 可收到新消息推送
ENABLE_PUSH_RELAY_SERVER=true

# ===================== SMTP（可选，用于发邮件）=====================
# 留空则使用服务器 sendmail；配置后可发送客户邮件、找回密码等
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
MAILER_SENDER_EMAIL=Chatwoot <no-reply@your-domain.com>
SMTP_DOMAIN=your-domain.com

# ===================== IP 定位（可选）=====================
# 无需任何 key：镜像启动时自动下载 ip2region 离线库（约 11MB，中国 IP 精确到省市区+运营商）
# 无需注册/付费/配置，留空即自动生效；删掉 vendor/db/ip2region.xdb 后重启可更新数据
IP_LOOKUP_API_KEY=
